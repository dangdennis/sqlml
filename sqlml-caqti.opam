# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Caqti driver for sqlml, with connection pooling"
description: """
Runs generated queries through Caqti over Eio, which adds connection
 pooling and concurrency. Eio is direct style, so generated signatures are
 unchanged: a query returns a plain result rather than a promise."""
maintainer: ["Dennis Dang"]
authors: ["Dennis Dang"]
license: "MIT"
homepage: "https://github.com/dangggdennis/sqlml"
doc: "https://dangggdennis.github.io/sqlml"
bug-reports: "https://github.com/dangggdennis/sqlml/issues"
depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.16" & >= "3.16"}
  "sqlml" {= version}
  "caqti" {>= "3.0.0"}
  "caqti-eio" {>= "3.0.0"}
  "uri" {>= "4.0.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/dangggdennis/sqlml.git"
