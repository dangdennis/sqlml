# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "SQL-first, type-safe query compiler for OCaml"
description: """
sqlml compiles .sql files into typed OCaml query modules, in the style of
 sqlc. Types are inferred by asking PostgreSQL directly (Parse/Describe),
 and the generated modules are executed through a small runtime whose
 execution API uses modular explicits: the query module you pass determines
 the parameter and result types."""
maintainer: ["Dennis Dang"]
authors: ["Dennis Dang"]
license: "MIT"
homepage: "https://github.com/dangggdennis/sqlml"
bug-reports: "https://github.com/dangggdennis/sqlml/issues"
depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.16" & >= "3.16"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/dangggdennis/sqlml.git"
