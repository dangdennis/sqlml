# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Typed OCaml from your SQL, checked against PostgreSQL"
description: """
Write .sql files with sqlc-style annotations; sqlml asks PostgreSQL for the
 parameter and result types of each query and emits typed OCaml. This package
 is the runtime that generated code depends on: value encoding and decoding,
 the query interface, transactions, and the driver boundary. It pulls in no
 database client of its own -- add sqlml-postgresql or sqlml-caqti for that."""
maintainer: ["Dennis Dang"]
authors: ["Dennis Dang"]
license: "MIT"
homepage: "https://github.com/dangdennis/sqlml"
doc: "https://github.com/dangdennis/sqlml"
bug-reports: "https://github.com/dangdennis/sqlml/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.16" & >= "3.16"}
  "ptime" {>= "1.0.0"}
  "uuidm" {>= "0.9.8"}
  "decimal" {>= "1.0.0"}
  "yojson" {>= "2.0.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/dangdennis/sqlml.git"
