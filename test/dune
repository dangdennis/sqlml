; Three stanzas, split by what each suite links, so `--with-test` on an opam
; build of a single package runs that package's suites. test_generated needs
; example/generated (workspace-local, no package), so it runs in the dev
; workspace only.

(tests
 (names test_sqlml test_sqlstate test_interval test_value_row)
 (package sqlml)
 (libraries sqlml ptime))

(tests
 (names
  test_parse
  test_typemap
  test_config
  test_run
  test_resolve_render
  test_snapshot)
 (package sqlml-postgresql)
 (deps render_golden.ml.expected render_golden.mli.expected)
 (libraries sqlml_gen unix))

(test
 (name test_generated)
 (libraries sqlml generated ptime uuidm decimal yojson))
