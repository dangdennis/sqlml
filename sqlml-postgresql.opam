# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "The sqlml code generator, CLI, and libpq driver"
description: """
Provides the `sqlml` command (generate, check, describe) and a PostgreSQL
 driver built directly on libpq. The generator needs libpq rather than a
 higher-level client because it uses PQdescribePrepared together with
 PQftable and PQftablecol, which are what tell it a result column's
 originating table -- the basis for nullability and shared row types."""
maintainer: ["Dennis Dang"]
authors: ["Dennis Dang"]
license: "MIT"
homepage: "https://github.com/dangdennis/sqlml"
doc: "https://github.com/dangdennis/sqlml"
bug-reports: "https://github.com/dangdennis/sqlml/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.5.0"}
  "sqlml" {= version}
  "dune-build-info"
  "cmdliner" {>= "1.3.0"}
  "otoml" {>= "1.0.0"}
  "conf-postgresql"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/dangdennis/sqlml.git"
x-maintenance-intent: ["(latest)"]
