; Raw libpq binding, shared by the generator (which needs PQdescribePrepared,
; PQftable and PQftablecol) and the libpq driver (which needs PQexecParams).
; Kept separate so neither depends on the other.

(library
 (name pq)
 (public_name sqlml-postgresql.pq)
 (foreign_stubs
  (language c)
  (names pq_stubs)
  (flags
   (:include pq_cflags.sexp)))
 (c_library_flags
  (:include pq_libs.sexp)))

(rule
 (targets pq_cflags.sexp)
 (deps discover.sh)
 (action
  (with-stdout-to
   pq_cflags.sexp
   (run sh %{dep:discover.sh} cflags))))

(rule
 (targets pq_libs.sexp)
 (deps discover.sh)
 (action
  (with-stdout-to
   pq_libs.sexp
   (run sh %{dep:discover.sh} libs))))
